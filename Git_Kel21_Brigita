
def pakan_harian(bobot, jenis_makanan, is_sakit):
    if jenis_makanan == 1:    
        porsi = bobot * 0.05
    elif jenis_makanan == 2:
        porsi = bobot * 0.02
    elif jenis_makanan == 3:  
        porsi = bobot * 0.03
    else:
        return None

    if is_sakit:
        porsi += porsi * 0.15
    return porsi

def biaya_kebersihan():
    return 50000.0 

